@@ -9,6 +9,8 @@
 
 include(GNUInstallDirs)
 
+option(SOPLEX_BUILD_EXECUTABLE "Build the SoPlex executable" ON)
+
 include_directories(BEFORE ${CMAKE_CURRENT_SOURCE_DIR})
 
 set(sources
@@ -192,6 +194,7 @@
