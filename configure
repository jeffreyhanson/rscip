#!/bin/sh

echo "Use 'configure'"

if test -z "${R_SCIP_LIB_DIR}"; then
    R_SCIP_PKG_HOME=`pwd`
    bash inst/build_scip.sh
    cd "${R_SCIP_PKG_HOME}"
    # remove extracted sources to keep the package tree small
    find inst -maxdepth 1 -type d -name 'scipoptsuite-*' -exec rm -rf {} +
    R_SCIP_LIB_DIR=${R_SCIP_PKG_HOME}/src/sciplib
fi

sed -e "s|@RSCIP_LIB_DIR@|${R_SCIP_LIB_DIR}|g" src/Makevars.in > src/Makevars

if [ ! -d "${R_SCIP_LIB_DIR}/include" ] || [ ! -d "${R_SCIP_LIB_DIR}/lib" ]; then
    echo "'SCIP' libraries could not be found!"
    exit 1
fi
